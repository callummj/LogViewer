<Window x:Class="LogViewerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviours="clr-namespace:LogViewerApp.Behaviours"
        Title="LogViewer" Height="800" Width="1400"
        Background="#F0F0F0"
        WindowState="Maximized">
        
        <DockPanel>
                <Menu DockPanel.Dock="Top">
                        <MenuItem Header="_File">
                                <MenuItem Header="_Open" />
                                <Separator />
                                <MenuItem Header="_Exit" />
                        </MenuItem>
                        
                        <MenuItem Header="_Edit"/>
                </Menu>
                <TextBox AcceptsReturn="True" />
                
                <Grid>

                        <Canvas Background="White"
                                behaviours:MouseWheelZoomBehavior.Zoom="{Binding Zoom}">

                                <Canvas.RenderTransform>
                                        <ScaleTransform
                                                ScaleX="{Binding Zoom}"
                                                ScaleY="{Binding Zoom}" />
                                </Canvas.RenderTransform>

                                <TextBlock Text="Equipment 1"
                                           FontSize="40"
                                           Canvas.Left="100"
                                           Canvas.Top="100"/>

                        </Canvas>

                </Grid>
        </DockPanel>
        
</Window>
