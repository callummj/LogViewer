<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:LogViewer.ViewModels"
                    xmlns:views="clr-namespace:LogViewer.Views">
    
    <DataTemplate x:Key="LogViewDashboardModelTemplate" DataType="viewModels:LogDashboardDashboardViewModel">
        <views:LogDashboardView x:DataType="viewModels:LogDashboardDashboardViewModel" />
    </DataTemplate>
    
    <DataTemplate x:Key="LogViewModelTemplate" DataType="viewModels:LogViewModel">
        <views:LogView x:DataType="viewModels:LogViewModel" />
    </DataTemplate>

    
</ResourceDictionary>