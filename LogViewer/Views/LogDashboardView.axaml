<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:LogViewer.ViewModels"
             xmlns:views="clr-namespace:LogViewer.Views"
             xmlns:iconPacks="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LogViewer.Views.LogDashboardView"
             x:DataType="viewModels:LogDashboardDashboardViewModel">
   
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <viewModels:LogDashboardDashboardViewModel/>
    </Design.DataContext>
    
    
    <DockPanel LastChildFill="True">
    
        <Grid>
            
            <Border IsVisible="{Binding IsAnyLogsOpen, Converter={x:Static BoolConverters.Not}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            
                <TextBlock 
                    TextAlignment="Center" 
                    Text="No Logs open, Click File > Open to select logs to open" 
                />
            </Border>
       
            <!-- The main TabControl -->
            <TabControl ItemsSource="{Binding Logs}" IsVisible="{Binding IsAnyLogsOpen}">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
            
                <TabControl.ItemTemplate>
                    <!-- Explicitly set the data type for the tab item header here -->
                    <DataTemplate x:DataType="viewModels:LogViewModel">
                        <DockPanel LastChildFill="True">
                            <!-- Place the docked element FIRST inside a DockPanel -->
                            <Button DockPanel.Dock="Right" 
                                    Background="Transparent" 
                                    Padding="4,0"
                                    Command="{Binding $parent[TabControl].((viewModels:LogDashboardDashboardViewModel)DataContext).CloseLog}" 
                                    CommandParameter="{Binding}" >
                                <iconPacks:LucideIcon Kind="X" Size="16" StrokeWidth="2"/>
                            </Button>
                            <TextBlock VerticalAlignment="Center" 
                                       Text="{Binding FileName}" />
                            
                            <DockPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Close" 
                                              Command="{Binding $parent[TabControl].((viewModels:LogDashboardDashboardViewModel)DataContext).CloseLog}" 
                                              CommandParameter="{Binding}" />
                                    
                                    <Separator />
                                    
                                    <MenuItem Header="CloseAll" 
                                              Command="{Binding $parent[TabControl].((viewModels:LogDashboardDashboardViewModel)DataContext).CloseAllLogs}" 
                                               />
                                    
                                </MenuFlyout>
                            </DockPanel.ContextFlyout>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="viewModels:LogViewModel">
                        <views:LogView />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        
        </Grid>
    </DockPanel>
    
</UserControl>
