<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:LogViewer.ViewModels"
             xmlns:views="clr-namespace:LogViewer.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LogViewer.Views.LogDashboardView"
             x:DataType="viewModels:LogDashboardDashboardViewModel">
   
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <viewModels:LogDashboardDashboardViewModel/>
    </Design.DataContext>
    
    
    <DockPanel LastChildFill="True">
    
        <Grid>
            
            <Border IsVisible="{Binding IsAnyLogsOpen, Converter={x:Static BoolConverters.Not}}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            
                <TextBlock 
                    TextAlignment="Center" 
                    Text="No Logs open, Click File > Open to select logs to open" 
                />
            </Border>
       
            <!-- The main TabControl -->
            <TabControl ItemsSource="{Binding Logs}" IsVisible="{Binding IsAnyLogsOpen}">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
            
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FileName}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="viewModels:LogViewModel">
                        <views:LogView />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        
        </Grid>
    </DockPanel>
    
</UserControl>
