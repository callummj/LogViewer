<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:LogViewer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LogViewer.Views.LogDashboardView"
             x:DataType="viewModels:LogDashboardDashboardViewModel">
   
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <viewModels:LogDashboardDashboardViewModel/>
    </Design.DataContext>
    
    
    <DockPanel LastChildFill="True" DockPanel.Dock="Top">

        <TextBlock Text="LogDashboard" DockPanel.Dock="Top" Margin="10" FontWeight="Bold"/>
        
        <!-- The Dynamic TabControl fills the entire canvas panel space -->
        <TabControl ItemsSource="{Binding Logs}">
            
            <!-- 1. THE TAB HEADER BUTTONS -->
            <TabControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:ILogViewModel}">
                    <!-- Vertically group elements using an implicit StackPanel inside the header -->
                    <StackPanel Orientation="Horizontal" IsHitTestVisible="True">
                        <TextBlock Text="{Binding FileName, FallbackValue='Active Log File'}" 
                                   VerticalAlignment="Center">
                            <ToolTip>
                                <TextBlock Text="{Binding FileLocation.AbsolutePath}"/>
                            </ToolTip>
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <!-- Use an actual MenuItem instead of a raw Button for standard UX behaviors -->
                                    <MenuItem Header="Close File" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            
            <!-- 2. THE TAB VIEWPORT CONTENT FIX -->
            <TabControl.ContentTemplate>
                <!-- CRITICAL: Do NOT define a DataType attribute here! -->
                <!-- Leaving this empty forces Avalonia to evaluate each tab item as an independent instance -->
                <DataTemplate>
                    <ContentControl Content="{Binding}" />
                </DataTemplate>
            </TabControl.ContentTemplate>
            
        </TabControl>
    </DockPanel>
</UserControl>
