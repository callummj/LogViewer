<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LogViewer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="LogViewer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LogViewer"
        WindowState="Maximized"
        Background="WhiteSmoke">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel/>
    </Design.DataContext>

    <DockPanel>
        
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" />
                <MenuItem Header="_Open" Command="{Binding OpenLogFilesCommand}"/>
                <MenuItem Header="_Save" />
                <Separator />
                <MenuItem Header="_Exit" />
            </MenuItem>
            
            <MenuItem Header="_Edit"/>
            <MenuItem Header="_View"/>
            <MenuItem Header="_Window"/>
            <MenuItem Header="_Tools"/>
            <MenuItem Header="_Help"/>
        </Menu>
      
        <Grid RowDefinitions="*, Auto" PointerWheelChanged="OnPointerWheelChanged">

            <!-- 1. THE VIEWPORT -->
            <ScrollViewer Grid.Row="0" 
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto"
                          ClipToBounds="True">
        
                <!-- The item you want to zoom -->
                <Border CornerRadius="8"
                        RenderTransformOrigin="50%,50%">
                    
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                    
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding #ZoomBar.Value}" 
                                        ScaleY="{Binding #ZoomBar.Value}"/>
                    </Border.RenderTransform>
                </Border>
            </ScrollViewer>

            <!-- 2. THE ZOOM CONTROL BAR -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <TextBlock Text="Zoom: " VerticalAlignment="Center"/>
        
                <!-- Keep the scrollbar: it will now automatically update when the wheel moves -->
                <ScrollBar x:Name="ZoomBar" 
                           Orientation="Horizontal" 
                           Width="200" 
                           Minimum="0.5" 
                           Maximum="4.0" 
                           Value="1.0" 
                           Height="20"/>
        
                <TextBlock Text="{Binding #ZoomBar.Value, StringFormat={}{0:P0}}" 
                           VerticalAlignment="Center" 
                           Margin="10,0,0,0" 
                           Width="50"/>
            </StackPanel>
        </Grid>
      
      
    </DockPanel>

</Window>
